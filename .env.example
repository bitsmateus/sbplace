# Copie este arquivo para .env (uso local) ou configure estas variáveis
# diretamente no EasyPanel, em Environment do serviço.

# Senha de acesso ao painel /admin. Troque para algo forte antes de ir pro ar.
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para assinar a sessão de login do admin.
# Gere uma aleatória com: openssl rand -base64 32
SESSION_SECRET=gere-uma-chave-aleatoria-longa-aqui

# Número de WhatsApp da loja (com DDI 55 + DDD, só números, sem espaços/símbolos)
# Exemplo Tubarão/SC: 5548999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5548999999999

# Instagram da loja (sem @)
NEXT_PUBLIC_INSTAGRAM=sbplaceoficial

# Endereço mostrado no rodapé e na página de contato
NEXT_PUBLIC_ADDRESS=Tubarão / SC

# Pasta onde o banco de dados (SQLite) e as fotos enviadas ficam salvos.
# No Docker/EasyPanel isso deve apontar para o volume persistente.
DATA_DIR=/app/data

# --- Pagamento online (e.Rede / Itaú) ---
# Sem REDE_PV e REDE_TOKEN o checkout fica desligado e o site continua
# mandando o cliente para o WhatsApp.
# PV = número de afiliação da loja; TOKEN = token de integração (chave).
REDE_PV=
REDE_TOKEN=
# "sandbox" (teste, sem cobrança real) ou "production". Comece em sandbox.
REDE_ENV=sandbox
# Texto na fatura do cliente (até 13 letras/números, sem acento). Deixe vazio:
# só preencha se a Rede tiver habilitado o "soft descriptor" na sua conta,
# senão ela recusa todas as transações.
REDE_SOFT_DESCRIPTOR=
# 3D Secure (confirmação no app/SMS do banco): ligado por padrão.
# Só coloque false se a Rede desabilitar o 3DS na conta.
REDE_3DS=true

# --- Notificações de WhatsApp (API oficial via NX / Z-PRO) ---
# Sem estas três, nenhuma mensagem é enviada. Os templates são escolhidos em
# Configurações → Notificações de WhatsApp, no painel.
NX_API_URL=
NX_API_ID=
NX_API_TOKEN=
# Endereço público do site, usado no link do pedido enviado ao cliente
# (opcional: sem ele, usa o endereço pelo qual o cliente acessou o site).
SITE_URL=
