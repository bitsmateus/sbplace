# Copie este arquivo para .env (uso local) ou configure estas variáveis
# diretamente no EasyPanel, em Environment do serviço.

# Senha de acesso ao painel /admin. Troque para algo forte antes de ir pro ar.
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para assinar a sessão de login do admin.
# Gere uma aleatória com: openssl rand -base64 32
SESSION_SECRET=gere-uma-chave-aleatoria-longa-aqui

# Número de WhatsApp da loja (com DDI 55 + DDD, só números, sem espaços/símbolos)
# Exemplo Tubarão/SC: 5548999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=5548999999999

# Instagram da loja (sem @)
NEXT_PUBLIC_INSTAGRAM=sbplaceoficial

# Endereço mostrado no rodapé e na página de contato
NEXT_PUBLIC_ADDRESS=Tubarão / SC

# Pasta onde o banco de dados (SQLite) e as fotos enviadas ficam salvos.
# No Docker/EasyPanel isso deve apontar para o volume persistente.
DATA_DIR=/app/data
